# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek
DEEPSEEK_API_KEY=sk-...

# Kimi (Moonshot AI)
KIMI_API_KEY=sk-...

# Tavily (web search for supplier research)
TAVILY_API_KEY=tvly-...

# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# Mistral AI (vendor discovery agent)
MISTRAL_API_KEY=

# Google Places API (location-based vendor search)
GOOGLE_PLACES_API_KEY=

# Dev flag — set to "true" to skip the real GPT call and return fixture JSON
USE_MOCK_GPT=false

# Python backend (SQLAlchemy + SQLite — business profile storage & classification)
# Start with: cd backend && pip install -r requirements.txt && uvicorn main:app --reload --port 8000
BACKEND_URL=http://localhost:8000
